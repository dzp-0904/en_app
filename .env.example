# Copy to .env and fill in. .env is gitignored; this file is not, so never put a
# real value in it.

# --- Supabase (browser + server) --------------------------------------------
# Safe to ship to the client: the publishable key is protected by RLS. The
# secret/service-role key has no place in this application and must not be added.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Site origin (server only) ----------------------------------------------
# The absolute origin used to build invitation links, e.g.
# https://teched.blooperry.net — no trailing slash. Required in any deployment
# that sends invitation emails; in local development the request Host is used
# when this is unset.
#
# Deliberately not NEXT_PUBLIC_: a NEXT_PUBLIC_ value is inlined at build time,
# which would bake the domain into the image.
SITE_URL=

# --- SMTP (server only) ------------------------------------------------------
# Read only by lib/mail/mailer.ts, which is marked `server-only` — importing it
# from a Client Component is a build error, so these can never reach the browser.
# Never prefix any of them with NEXT_PUBLIC_.
#
# Port 465 is implicit TLS (SMTPS). Hostinger also accepts 587 with STARTTLS.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@blooperry.com
SMTP_PASSWORD=
